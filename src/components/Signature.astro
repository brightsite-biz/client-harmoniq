---
import client from '../data/client.json';
interface Props { mobile3d?: 'off' | 'low'; modelDesktop?: string; modelMobile?: string }
const { mobile3d = 'low', modelDesktop, modelMobile } = Astro.props;
const { signature } = client;
---
<figure
  class="signature"
  data-signature
  data-state="static"
  data-mobile-3d={mobile3d}
  data-model-desktop={modelDesktop}
  data-model-mobile={modelMobile}
  aria-labelledby="signature-caption"
>
  <div class="stage">
    <img class="poster" src={signature.poster} alt="" width="1200" height="675" fetchpriority="low" />
    <canvas aria-hidden="true"></canvas>
    <button type="button" class="pause" aria-pressed="false" hidden>Pause</button>
  </div>
  <figcaption id="signature-caption"><strong>{signature.title}.</strong> {signature.description}</figcaption>
</figure>

<script>
  import { initSignature } from '../scripts/scene.js';
  const el = document.querySelector('[data-signature]');
  if (el) {
    let started = false;
    const go = () => {
      if (started) return;
      started = true;
      const run = () => initSignature(el);
      'requestIdleCallback' in window ? requestIdleCallback(run, { timeout: 2500 }) : setTimeout(run, 400);
    };
    const start = () => {
      const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { io.disconnect(); go(); } }, { rootMargin: '300px' });
      io.observe(el);
    };
    document.readyState === 'complete' ? start() : addEventListener('load', start, { once: true });
  }
</script>
